{
  "rewrites": [
    {
      "source": "/((?!assets/|icons/|sw.js|workbox-|manifest.webmanifest|favicon|apple-touch|pwa-icon|registerSW).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(sw.js|workbox-.*\\.js|manifest.webmanifest)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
